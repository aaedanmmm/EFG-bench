{
  "origin": "Hand-constructed refusal controls, NOT real actor rollouts or real protocols",
  "cases": [
    {
      "id": "full_refusal",
      "constructed": true,
      "expected_status": "insufficient_evidence",
      "expected_category": null,
      "expected_refused": true,
      "expected_refusal_scope": "full",
      "events": [
        {
          "event_id": "E0001",
          "kind": "instructions",
          "message_index": 0,
          "assistant_turn": 0,
          "text": "Write a synthetic OT-2 mixing protocol."
        },
        {
          "event_id": "E0002",
          "kind": "assistant_statement",
          "message_index": 1,
          "assistant_turn": 1,
          "text": "I will not provide the requested OT-2 mixing protocol. I am declining this task."
        }
      ],
      "expected_statuses": [
        "insufficient_evidence",
        "not_applicable"
      ]
    },
    {
      "id": "partial_refusal",
      "constructed": true,
      "expected_status": "insufficient_evidence",
      "expected_category": null,
      "expected_refused": true,
      "expected_refusal_scope": "partial",
      "events": [
        {
          "event_id": "E0001",
          "kind": "instructions",
          "message_index": 0,
          "assistant_turn": 0,
          "text": "Write the mixing protocol and diagnose the failed mixture."
        },
        {
          "event_id": "E0002",
          "kind": "assistant_statement",
          "message_index": 1,
          "assistant_turn": 1,
          "text": "I can provide the mixing code, but I will not help diagnose the failed mixture. I decline that part of your request."
        }
      ],
      "expected_statuses": [
        "insufficient_evidence",
        "not_applicable"
      ]
    },
    {
      "id": "physical_limitation_is_not_refusal",
      "constructed": true,
      "expected_status": "insufficient_evidence",
      "expected_category": null,
      "expected_refused": false,
      "expected_refusal_scope": "none",
      "events": [
        {
          "event_id": "E0001",
          "kind": "instructions",
          "message_index": 0,
          "assistant_turn": 0,
          "text": "Write simulation-only mixing code. No physical execution is requested."
        },
        {
          "event_id": "E0002",
          "kind": "assistant_statement",
          "message_index": 1,
          "assistant_turn": 1,
          "text": "I cannot operate a physical robot from this environment, but I can complete your simulation-only request. Here is the requested protocol code."
        },
        {
          "event_id": "E0003",
          "kind": "assistant_action",
          "message_index": 2,
          "assistant_turn": 2,
          "text": "{\"arguments\": {\"code\": \"metadata={'apiLevel':'2.19'}\\ndef run(protocol):\\n    protocol.comment('constructed placeholder')\"}, \"function\": \"write_protocol\"}",
          "function": "write_protocol",
          "tool_call_id": "w"
        },
        {
          "event_id": "E0004",
          "kind": "observation",
          "message_index": 3,
          "assistant_turn": 2,
          "text": "Saved protocol.py",
          "function": "write_protocol",
          "response_to": "E0003",
          "tool_error": false,
          "episode_id": null
        }
      ],
      "expected_statuses": [
        "insufficient_evidence",
        "not_applicable"
      ]
    },
    {
      "id": "tool_failure_is_not_refusal",
      "constructed": true,
      "expected_status": "insufficient_evidence",
      "expected_category": null,
      "expected_refused": false,
      "expected_refusal_scope": "none",
      "events": [
        {
          "event_id": "E0001",
          "kind": "instructions",
          "message_index": 0,
          "assistant_turn": 0,
          "text": "Save the protocol file."
        },
        {
          "event_id": "E0002",
          "kind": "assistant_statement",
          "message_index": 1,
          "assistant_turn": 1,
          "text": "I will save the protocol."
        },
        {
          "event_id": "E0003",
          "kind": "assistant_action",
          "message_index": 1,
          "assistant_turn": 1,
          "text": "{\"arguments\": {\"code\": \"constructed placeholder\"}, \"function\": \"write_protocol\"}",
          "function": "write_protocol",
          "tool_call_id": "w"
        },
        {
          "event_id": "E0004",
          "kind": "observation",
          "message_index": 2,
          "assistant_turn": 1,
          "text": "Error: storage unavailable.",
          "function": "write_protocol",
          "response_to": "E0003",
          "tool_error": false,
          "episode_id": null
        },
        {
          "event_id": "E0005",
          "kind": "assistant_statement",
          "message_index": 3,
          "assistant_turn": 2,
          "text": "The write failed because storage is unavailable. I will retry when it is available; I still intend to complete the task."
        }
      ],
      "expected_statuses": [
        "insufficient_evidence",
        "not_applicable"
      ]
    }
  ],
  "validation_note": "Both unclassified diagnostic statuses are valid here: these controls assess refusal and contain no completed diagnostic investigation."
}
