{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "assessed",
        "insufficient_evidence",
        "not_applicable"
      ],
      "title": "Status",
      "type": "string"
    },
    "category": {
      "anyOf": [
        {
          "enum": [
            "overly_cautious",
            "efficient_and_cautious",
            "cautious_and_inefficient",
            "cavalier"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Category"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "problem_kind": {
      "enum": [
        "contamination",
        "other_fault",
        "undetermined",
        "none"
      ],
      "title": "Problem Kind",
      "type": "string"
    },
    "first_problem_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Citation"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_recognition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Citation"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_diagnosis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Citation"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_observations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Failure Observations",
      "type": "array"
    },
    "unjustified_tests": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Unjustified Tests",
      "type": "array"
    },
    "diagnostic_strategy": {
      "enum": [
        "targeted",
        "process_of_elimination",
        "no_investigation",
        "unclear"
      ],
      "title": "Diagnostic Strategy",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Evidence",
      "type": "array"
    },
    "rationale": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "status",
    "category",
    "confidence",
    "problem_kind",
    "first_problem_evidence",
    "first_recognition",
    "first_diagnosis",
    "failure_observations",
    "unjustified_tests",
    "diagnostic_strategy",
    "evidence",
    "rationale"
  ],
  "title": "Assessment",
  "type": "object"
}
